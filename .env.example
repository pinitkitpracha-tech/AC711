# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
PORT=3000
BASE_URL=https://www.ac711.com          # ใช้สร้างลิงก์ในอีเมล ยืนยันอีเมล/รีเซ็ตรหัสผ่าน
JWT_SECRET=เปลี่ยนเป็นข้อความสุ่มยาว ๆ อย่างน้อย 32 ตัว
DATA_DIR=./data                          # โฟลเดอร์ SQLite + รูปอัปโหลด (บนเซิร์ฟเวอร์ใช้ /var/data)
TRUST_PROXY=0                            # ตั้งเป็น 1 เฉพาะเมื่ออยู่หลัง reverse proxy (Nginx/Caddy/Render)

# Admin Console (#/admin) — ใช้ตอนสร้างฐานข้อมูลครั้งแรก ต่อจากนั้นเปลี่ยนในหน้า ตั้งค่าแอดมิน
ADMIN_USER=admin
ADMIN_PASSWORD=เปลี่ยนก่อนเปิดใช้จริง

# อีเมลจริง (ไม่ตั้ง = โหมดทดสอบ แสดงอีเมลบนหน้าจอแทนการส่ง)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=app-password-16-ตัว
MAIL_FROM=AC711 <no-reply@ac711.com>

# ผู้ช่วย AI (ไม่บังคับ) — ใส่แล้วเมนู AI ใช้ Claude จริง
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
